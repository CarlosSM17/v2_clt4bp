APP_NAME="CLT4BP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
# Puerto del contenedor de infra/docker-compose.yml (5433 si el equipo ya usa el 5432)
DB_PORT=5432
DB_DATABASE=clt4bp
DB_USERNAME=clt4bp
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Debe superar AGENTE_TIMEOUT + 60: si no, la cola relanza una generación que sigue en curso
DB_QUEUE_RETRY_AFTER=1000

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-responder@clt4bp.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Administrador inicial (lo usa AdminSeeder; borra ADMIN_PASSWORD despues de sembrar)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Servicios que se usaran en etapas siguientes
PISTON_URL=http://127.0.0.1:2000/api/v2
AGENTE_URL=http://127.0.0.1:8100
AGENTE_TOKEN=
# Segundos que puede tardar una generación: 900 con un modelo local (PROVEEDOR=local), 280 basta con Claude
AGENTE_TIMEOUT=900
# directo: Laravel llama al agente en AGENTE_URL (todo en un equipo o servidor). relevo: el agente corre en el equipo
# del instructor y su conector viene por el trabajo (plataforma en Railway; ADR 0008 y docs/despliegue-railway.md)
AGENTE_MODO=directo

# Detrás de un proxy que termina TLS (Railway): * para confiar en él. Vacío en local y con nginx en el mismo servidor
CLT4BP_PROXIES_CONFIABLES=
