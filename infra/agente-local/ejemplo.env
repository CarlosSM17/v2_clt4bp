# Copia este archivo a .env y llénalo. Nunca lo subas al repositorio: lleva el secreto del agente.

# Dirección de la plataforma en la nube, sin barra final (la de Railway o tu dominio)
RELEVO_URL=https://tu-app.up.railway.app

# El MISMO valor que AGENTE_TOKEN en las variables del servicio web de Railway. Genera uno largo, por ejemplo:
#   PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
#   macOS/Linux: openssl rand -hex 32
AGENTE_TOKEN=

# Modelo: local (Ollama en este equipo; nada sale de él) o claude (requiere ANTHROPIC_API_KEY)
PROVEEDOR=local
# Con una GPU de 8 GB, qwen3:4b; con 12 GB o más libres, qwen3:8b como normal
MODELO_LOCAL_NORMAL=qwen3:4b
# ANTHROPIC_API_KEY=

# Linux: Ollama debe escuchar en todas las interfaces para que el contenedor lo alcance (OLLAMA_HOST=0.0.0.0 en su
# servicio). En Windows y macOS (Docker Desktop) no hace falta.
# OLLAMA_URL=http://host.docker.internal:11434

# Solicitudes que el conector atiende a la vez (una generación tarda minutos; las demás no esperan por ella)
RELEVO_HILOS=3
