# /srv/clt4bp/shared/agente.env — configuración del agente en producción (chmod 600, dueño deploy).
AGENTE_TOKEN=
PISTON_URL=http://127.0.0.1:2000
# Trazador (pasos reales de las trazas de código, con gdb): infra/prod/trazador.yml
TRAZADOR_URL=http://127.0.0.1:2010

# Proveedor del modelo: local (Ollama en este servidor; nada sale de él) o claude (API de Anthropic).
# Cambiarlo a mitad del piloto cambia el «tratamiento»: decídelo antes y anótalo en el protocolo.
PROVEEDOR=local
OLLAMA_URL=http://127.0.0.1:11434
# Por omisión: qwen3:4b (normal y ligero) y qwen3:8b («calidad alta»), para una GPU de 8 GB.
# Con 12 GB o más de VRAM libre: MODELO_LOCAL_NORMAL=qwen3:8b (ADR 0006)
# MODELO_LOCAL_NORMAL=qwen3:4b
# OLLAMA_NUM_CTX=16384
# Embeddings del material del curso: siempre locales (dimensión 1024 fija en la migración)
# MODELO_EMBEDDINGS=bge-m3

# Solo con PROVEEDOR=claude
ANTHROPIC_API_KEY=

# Errores al monitoreo (Etapa 7.5): vacío en desarrollo
SENTRY_DSN=
