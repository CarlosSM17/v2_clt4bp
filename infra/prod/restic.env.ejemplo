# /etc/clt4bp/restic.env -- dónde y cómo cifra restic los respaldos (chmod 600, dueño root).
# Un servidor SFTP de tu institución (la llave SSH de root debe estar autorizada allí)...
RESTIC_REPOSITORY=sftp:respaldos@respaldos.midominio.mx:/respaldos/clt4bp
# ...o un almacenamiento compatible con S3:
# RESTIC_REPOSITORY=s3:https://s3.proveedor.com/mi-bucket/clt4bp
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
RESTIC_PASSWORD_FILE=/etc/clt4bp/restic.clave
# URL de "sigo vivo" del monitoreo (7.5); vacío = sin aviso
PING_RESPALDO=
