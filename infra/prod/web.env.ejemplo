# /srv/clt4bp/shared/web.env — configuración de Laravel en producción (chmod 600, dueño deploy).
# Nunca en git: esta copia de ejemplo no lleva secretos.
APP_NAME="CLT4BP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://clt4bp.midominio.mx
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=clt4bp
DB_USERNAME=clt4bp
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database
# Debe superar AGENTE_TIMEOUT + 60: si no, la cola relanza una generación que sigue en curso
DB_QUEUE_RETRY_AFTER=1000
CACHE_STORE=database

# Correo: el SMTP de tu institución o un proveedor transaccional (puerto 465: agrega MAIL_SCHEME=smtps)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-responder@midominio.mx"
MAIL_FROM_NAME="${APP_NAME}"

PISTON_URL=http://127.0.0.1:2000/api/v2
AGENTE_URL=http://127.0.0.1:8100
AGENTE_TOKEN=
# Segundos que puede tardar una generación: 900 con un modelo local (PROVEEDOR=local), 280 basta con Claude
AGENTE_TIMEOUT=900

CLT4BP_AGENTE_LIMITE_USD=20
CLT4BP_CONTACTO_PRIVACIDAD=privacidad@midominio.mx

# Solo para el primer «db:seed»; borra ADMIN_PASSWORD en cuanto exista el administrador
ADMIN_NAME="Tu Nombre"
ADMIN_EMAIL=tu@midominio.mx
ADMIN_PASSWORD=

# Revisión automática de operación cada 5 minutos (Etapa 7.5)
CLT4BP_ALERTAS_CORREO=tu@midominio.mx
CLT4BP_PING_REVISION=
CLT4BP_ALERTA_GASTO_DIARIO_USD=5

# Errores al monitoreo (Etapa 7.5): vacío en desarrollo
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
