# Variables del servicio «web» de Railway (pégalas en Variables → Raw Editor y llena los valores marcados).
# Los ${{…}} son referencias de Railway: los servicios deben llamarse exactamente «db» y «ejecutor».
# Guía completa: docs/despliegue-railway.md

APP_NAME=CLT4BP
APP_ENV=production
APP_DEBUG=false
# Genérala en tu equipo con: cd apps/web; php artisan key:generate --show
APP_KEY=
APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

DB_CONNECTION=pgsql
DB_HOST=${{db.RAILWAY_PRIVATE_DOMAIN}}
DB_PORT=5432
DB_DATABASE=${{db.POSTGRES_DB}}
DB_USERNAME=${{db.POSTGRES_USER}}
DB_PASSWORD=${{db.POSTGRES_PASSWORD}}

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
# Mayor que AGENTE_TIMEOUT + 60: si no, la cola relanza una generación en curso
DB_QUEUE_RETRY_AFTER=1000
LOG_CHANNEL=stderr

# Agente en el equipo del instructor (relevo). El MISMO AGENTE_TOKEN va en infra/agente-local/.env de cada equipo.
# Genera uno largo (macOS/Linux: openssl rand -hex 32)
AGENTE_MODO=relevo
AGENTE_TOKEN=
AGENTE_TIMEOUT=900

# Ejecución de código de los estudiantes: el servicio «ejecutor» (services/trazador), solo por la red privada
PISTON_URL=http://${{ejecutor.RAILWAY_PRIVATE_DOMAIN}}:2010/api/v2

# Railway termina TLS: sin esto, las URL firmadas de los medios no validan
CLT4BP_PROXIES_CONFIABLES=*

# Primer despliegue: roles, catálogo de efectos, instrumentos y el administrador. Después, quita estas cuatro variables
CLT4BP_SEMBRAR=si
ADMIN_NAME=Administración
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Correo (verificación de cuentas, invitaciones, alertas): SMTP de la institución, de un proveedor o de Gmail
# (smtp.gmail.com con contraseña de aplicación). Railway bloquea el SMTP en Free, Trial y Hobby: con «failover», si
# no sale, el correo queda en el registro a los MAIL_TIMEOUT segundos en lugar de fallar
MAIL_MAILER=failover
MAIL_TIMEOUT=5
# Mientras el correo no salga (plan Hobby), las cuentas no pueden verificar su correo: false las deja entrar sin él.
# Con SMTP funcionando (plan Pro o un proveedor por API), quita esta línea para volver a pedir la verificación
CLT4BP_VERIFICAR_CORREO=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=CLT4BP

# Operación (opcionales)
CLT4BP_ALERTAS_CORREO=
CLT4BP_CONTACTO_PRIVACIDAD=
SENTRY_LARAVEL_DSN=
