AGENTE_TOKEN=
# Proveedor del modelo: local (Ollama en este equipo; nada sale de él) o claude (API de Anthropic)
PROVEEDOR=local
PISTON_URL=http://localhost:2000
# Trazador: pasos reales de las trazas de código (services/trazador, en infra/docker-compose.yml)
TRAZADOR_URL=http://localhost:2010

# Local: instala Ollama y los modelos con `ollama pull qwen3:4b`, `ollama pull qwen3:8b` y `ollama pull bge-m3`.
# Valores por omisión pensados para una GPU de 8 GB (ADR 0006); con 12 GB o más libres, MODELO_LOCAL_NORMAL=qwen3:8b
OLLAMA_URL=http://localhost:11434
# MODELO_LOCAL_NORMAL=qwen3:4b
# MODELO_LOCAL_LIGERO=qwen3:4b
# MODELO_LOCAL_ALTO=qwen3:8b   # «calidad alta»: en 8 GB no cabe entero y es lento
# OLLAMA_NUM_CTX=24576        # 24k cabe en 8 GB con qwen3:4b; 32k ya no
# OLLAMA_PENSAR=no             # no | si | omitir. «si» duplica el tiempo y se come el espacio de la respuesta
# OLLAMA_KEEP_ALIVE=30m        # cuánto sigue cargado el modelo sin uso
# Embeddings del material del curso: siempre locales. La dimensión (1024) está fija en la migración de Laravel
# MODELO_EMBEDDINGS=bge-m3

# Claude (solo con PROVEEDOR=claude)
ANTHROPIC_API_KEY=
# Opcionales: cambiar de modelo es configuración, no código
# MODELO_NORMAL=claude-sonnet-5
# MAX_INTENTOS=3
# Clase de tareas completa: tras la clase, el soporte y una ayuda por tarea en solicitudes aparte (app/etapas.py)
# CLASE_COMPLETA=true
# PRESUPUESTO_CLASE_S=600     # después de esto ya no se piden más; menor que AGENTE_TIMEOUT de Laravel
# Monitoreo de errores (Etapa 7): vacío en desarrollo
# SENTRY_DSN=
