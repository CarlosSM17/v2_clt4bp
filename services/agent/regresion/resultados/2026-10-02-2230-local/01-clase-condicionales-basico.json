        "lenguaje": "c",
        "codigo_inicial": "",
        "solucion": "#include <stdio.h>\n\nint main(void) {\n    int n, venta, contador = 0;\n    scanf(\"%d\", &n);\n    for (int i = 0; i < n; i++) {\n        scanf(\"%d\", &venta);\n        if (venta >= 100) {\n            contador++;\n        }\n    }\n    printf(\"%d\\n\", contador);\n    return 0;\n}",
