        "uid": "reg01-tc-t3-p2",
        "tarea_uid": "reg01-tc-t3",
        "tipo": "ejemplo_isomorfico",
        "titulo": "Ejemplo isomórfico: Ventas aprobatorias",
        "cuerpo_md": "```traza\ntitulo: Ventas aprobatorias\nlenguaje: c\nentrada: 3\\n100\\n50\\n75\n---\n#include <stdio.h>\n\nint main(void) {\n    int n, venta, suma = 0;\n    scanf(\"%d\", &n);\n    for (int i = 0; i < n; i++) {\n        scanf(\"%d\", &venta);\n        if (venta >= 100) {\n            suma++;\n        }\n    }\n    printf(\"%d\\n\", suma);\n    return 0;\n}\n---\n{\"l\":4,\"f\":\"main\",\"v\":[],\"s\":\"\",\"m\":[{\"f\":\"main\",\"v\":[]}]}\n{\"l\":5,\"f\":\"main\",\"v\":[[\"n\",\"?\"],[\"venta\",\"?\"],[\"suma\",\"0\"]],\"s\":\"\",\"m\":[{\"f\":\"main\",\"v\":[{\"n\":\"n\",\"d\":140735217649668,\"t\":\"valor\",\"x\":\"?\",\"tam\":4},{\"n\":\"venta\",\"d\":140735217649664,\"t\":\"valor\",\"x\":\"?\",\"tam\":4},{\"n\":\"suma\",\"d\":140735217649676,\"t\":\"valor\",\"x\":\"0\",\"tam\":4}]}]}\n{\"l\":6,\"f\":\"main\",\"v\":[[\"n\",\"3\"],[\"venta\",\"?\"],[\"suma\",\"0\"]],\"s\":\"\",\"m\":[{\"f\":\"main\",\"v\":[{\"n\":\"n\",\"d\":140735217649668,\"t\":\"valor\",\"x\":\"3\",\"tam\":4},{\"n\":\"venta\",\"d\":140735217649664,\"t\":\"valor\",\"x\":\"?\",\"tam\":4},{\"n\":\"suma\",\"d\":140735217649676,\"t\":\"valor\",\"x\":\"0\",\"tam\":4}]}]}\n{\"l\":7,\"f\":\"main\",\"v\":[[\"n\",\"3\"],[\"venta\",\"?\"],[\"suma\",\"0\"],[\"i\",\"0\"]],\"s\":\"\",\"m\":[{\"f\":\"main\",\"v\":[{\"n\":\"n\",\"d\":140735217649668,\"t\":\"valor\",\"x\":\"3\",\"tam\":4},{\"n\":\"venta\",\"d\":140735217649664,\"t\":\"valor\",\"x\":\"?\",\"tam\":4},{\"n\":\"suma\",\"d\":140735217649676,\"t\":\"valor\",\"x\":\"0\",\"tam\":4},{\"n\":\"i\",\"d\":140735217649672,\"t\":\"valor\",\"x\":\"0\",\"tam\":4}]}]}\n{\"l\":8,\"f\":\"main\",\"v\":[[\"n\",\"3\"],[\"venta\",\"100\"],[\"suma\",\"0\"],[\"i\",\"0\"]],\"s\":\"\",\"m\":[{\"f\":\"main\",\"v\":[{\"n\":\"n\",\"d\":140735217649668,\"t\":\"valor\",\"x\":\"3\",\"tam\":4},{\"n\":\"venta\",\"d\":140735217649664,\"t\":\"valor\",\"x\":\"100\",\"tam\":4},{\"n\":\"suma\",\"d\":140735217649676,\"t\":\"valor\",\"x\":\"0\",\"tam\":4},{\"n\":