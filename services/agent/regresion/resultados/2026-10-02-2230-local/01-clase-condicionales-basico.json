        "nivel_apoyo": "por_completar",
        "enunciado_md": "El gerente quiere saber cuál fue la venta más alta del día. Completa los huecos para que el programa lea **n** ventas y muestre la mayor con un decimal.",
        "arcs": {
          "atencion": "El gerente necesita conocer la venta más alta del día",
          "relevancia": "La venta más alta ayuda a identificar momentos de alta demanda",
          "confianza": "El programa solo requiere leer n ventas",
          "satisfaccion": "La venta más alta es fácil de interpretar"
        },
        "lenguaje": "c",
        "codigo_inicial": "#include <stdio.h>\n\nint main(void) {\n    int n, venta, max = 0;\n    scanf(\"%d\", &n);\n    for (int i = 0; i < n; i++) {\n        scanf(\"%d\", &venta);\n        /* HUECO 1: comparar con max */\n    }\n    printf(\"%.1f\\n\", max);\n    return 0;\n}",
